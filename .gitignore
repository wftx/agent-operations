# No trailing slash: `node_modules/` matches only real directories, so a
# SYMLINKED node_modules (common in worktree checkouts) evades it and can be
# committed — which once took down every agent sharing this checkout's bus.
node_modules
.claude/
!.claude/commands/
!.claude/commands/**
!.claude/orchestration-cortextos-node/
# Include template .claude dirs (needed for agent settings.json)
!templates/**/.claude/
!templates/**/.claude/**
dist/
ecosystem.config.js

# User-created org data (not part of the framework)
orgs/
# The dedicated Agent Operations rehearsal fixture is reusable framework
# configuration. Runtime state, memory, and secrets remain ignored below.
!orgs/
orgs/*
!orgs/agent-operations/
orgs/agent-operations/*
!orgs/agent-operations/agents/
orgs/agent-operations/agents/*
!orgs/agent-operations/agents/rehearsal/
!orgs/agent-operations/agents/rehearsal/**
orgs/agent-operations/agents/rehearsal/.agents/
orgs/agent-operations/agents/rehearsal/plugins/
!orgs/agent-operations/context.json
!orgs/agent-operations/goals.json
!orgs/agent-operations/knowledge.md
!orgs/agent-operations/brand-voice.md
orgs/agent-operations/secrets.env
# But community subdirectories ARE part of the framework
!community/
!community/**

# Secrets
.env
!.env.example
templates/*/.env
.cortextos-env

# Agent runtime data
orgs/*/agents/*/memory/
agents/*/local/
agents/*/telegram-images/
agents/*/memory/

# macOS metadata
.DS_Store

# Test artifacts
test-results/
*.log
# Spurious directory created when ${APPDATA} env var unexpanded during npm link on Windows
${APPDATA}/

# Knowledge base
knowledge-base/venv/
knowledge-base/__pycache__/
knowledge-base/scripts/__pycache__/
knowledge-base/scripts/_test_clients/__pycache__/
tests/playwright/dashboard-ui.spec.ts

# Local ops docs (personal, not for public repo)
docs/

# Public architecture decisions are repository documentation.
!docs/
docs/*
!docs/architecture/
docs/architecture/*
!docs/architecture/decisions/
!docs/architecture/decisions/**
!docs/agent-operations/
!docs/agent-operations/runtime-rehearsal-setup.md

# Internal developer/planning notes (not for public repo)
KNOWN-ISSUES.md
WINDOWS-IMPLEMENTATION-PLAN.md
WINDOWS-SUPPORT-INVESTIGATION.md
BRAINDUMP*.md
AGENTS.md
!orgs/agent-operations/agents/rehearsal/AGENTS.md
dashboard/screenshots/
dashboard/test-*.py

# Public community agent templates may intentionally include their own docs,
# AGENTS.md, memory skill, and scaffold files.
!community/agents/research-agent/
!community/agents/research-agent/**

# Internal ops/dev reports — never public (2026-07-01 leak remediation, SEC-1 L4).
# docs/ is already ignored above; these cover root-level and phase-report globs
# so a dev artifact cannot re-track outside docs/. Real user docs live elsewhere.
WINDOWS_INSTALL_REPORT.md
*INSTALL_REPORT.md
/PHASE*-REPORT.md
docs/phase-reports/

# claude-to-codex-migration leakage-guard fixture (author-specific ban tokens: fleet
# roster + specific chat-ids). CI/local ONLY, pointed at by CTX_LEAKAGE_FIXTURE. NEVER
# public — glob'd broadly so it can never be accidentally committed into the tree.
leakage-fixture.json
**/leakage-fixture.json
*.leakage-fixture.json
